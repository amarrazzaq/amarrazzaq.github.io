<header class="top-header" id="header">
  <div class="nav-container">
    <a href="/" class="header-brand">
      <span class="header-brand-name"><span class="first-name">Dr.</span> {{ site.name }}</span>
      <span class="header-brand-title">{{ site.title }}</span>
    </a>
    <div class="nav-actions">
      <button class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark/light mode">
        <i class="fa-solid fa-sun sun-icon" aria-hidden="true"></i>
        <i class="fa-solid fa-moon moon-icon" aria-hidden="true"></i>
      </button>
      <button class="hamburger-menu" aria-label="Menu" aria-expanded="false">
        <i class="fas fa-bars" aria-hidden="true"></i>
      </button>
    </div>
    <nav class="nav-links" id="nav-menu">
{%- for item in site.nav %}
      <a href="{{ item.url }}"{% if item.key == nav %} aria-current="page"{% endif %}>{{ item.label }}</a>
{%- endfor %}
    </nav>
  </div>
</header>
