---
permalink: /outreach/index.html
nav: outreach
---
{% extends "layouts/base.njk" %}

{% block head %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Canonical Tag -->
    <link rel="canonical" href="https://amarrazzaq.com/outreach" />

    <!-- SEO Meta Tags -->
    <meta name="description" content="Community engagement and knowledge transfer activities by Dr. Amar Razzaq, including international collaboration and e-commerce initiatives.">
    <meta name="keywords" content="community outreach, e-commerce research, international collaboration, agricultural education, knowledge transfer">
    <meta name="author" content="Amar Razzaq">
    <meta name="robots" content="index, follow">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Outreach - Dr. Amar Razzaq">
    <meta property="og:description" content="Community engagement and international collaboration initiatives in agricultural economics.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://amarrazzaq.com/outreach">
    <meta property="og:site_name" content="Amar Razzaq">
    <meta property="og:image" content="https://amarrazzaq.com/images/amar.jpg">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Dr. Amar Razzaq">

    <title>Outreach - Amar Razzaq</title>
    <link rel="stylesheet" href="/style.css">
<!-- Favicon Links -->
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/images/favicon.png" type="image/png">
    <!-- Optional: Apple Touch Icon for better iOS support -->
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
{% endblock %}

{% block content %}
    <main class="main-content single-column">
        <div class="content-section">
            <h1 class="page-title">Outreach</h1>
            <p class="page-lead">Talks, forums and engagement beyond academic publishing.</p>

            <section class="talks">
                <h2 class="section-title">Talks</h2>
{%- macro talk(t, year) %}
                    <li>{% if t.keynote %}<em>Keynote:</em> {% endif %}“{{ t.title }}.” <span class="talk-venue">{{ t.venue }}, {{ t.month }} {{ year }}.</span></li>
{%- endmacro %}
                <h3 class="year-header">Forthcoming</h3>
                <ul class="talk-list">
{%- for t in talks.forthcoming %}{{ talk(t, t.year) }}{% endfor %}
                </ul>
{%- for y in talks.years %}
                <h3 class="year-header">{{ y.year }}</h3>
                <ul class="talk-list">
{%- for t in y.talks %}{{ talk(t, y.year) }}{% endfor %}
                </ul>
{%- endfor %}
            </section>

            <section>
                <h2 class="section-title">Other engagement</h2>
                <ul class="plain-list engagement">
                    <li>Founding member of the Cross-Border E-commerce Research Group at Huazhong Agricultural University, which organised seven international cross-border e-commerce forums in China, Bangladesh and Pakistan.</li>
                    <li>Led the establishment of the Sino-Pak Cross-Border E-commerce Association, which works with Huazhong Agricultural University researchers to adapt China’s Taobao Village model to Pakistan.</li>
                    <li>Organised the International Cross-Border E-commerce Summer School in Ili, Xinjiang, China (2024), and trained students from several countries in rural and cross-border e-commerce.</li>
                    <li>Manager of the YOU Microfinance Fund, led by Prof. Zhou Deyi, which provides interest-free loans to farmers in Kenya, Pakistan and Bangladesh.</li>
                </ul>
            </section>
        </div>
    </main>
{% endblock %}
